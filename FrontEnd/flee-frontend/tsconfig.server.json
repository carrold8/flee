{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2017",
    "outDir": "dist",
    "rootDir": ".",
    "moduleResolution": "node",
    "noEmit": false,
    "isolatedModules": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "allowImportingTsExtensions": false,
  },
  "include": ["server.ts", "lib/**/*"],
  "exclude": ["node_modules", "pages", "public", ".next"]
}
